"""
EDGAR 10-K scraper — multithreaded, rate-limited to ~10 req/s.

Architecture:
  ┌──────────────────────────────────────────────────────────────┐
  │  Main thread  →  ThreadPoolExecutor  (download workers)      │
  │                        │                                      │
  │                  TokenBucket.acquire()  ← 1 token / 0.1 s   │
  │                        │                                      │
  │                        ▼  (file written to disk)             │
  │              parse_queue  (bounded Queue → back-pressure)    │
  │                        │                                      │
  │                        ▼                                      │
  │         ProcessPoolExecutor  (parse workers, CPU-1 cores)    │
  │         BeautifulSoup + ET parse → two CSVs per filing       │
  └──────────────────────────────────────────────────────────────┘
"""

import os
import re
import time
import queue
import threading
import multiprocessing
from collections import deque
from pathlib import Path
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor, ProcessPoolExecutor
from typing import Optional

import pandas as pd
import requests
from bs4 import BeautifulSoup
import xml.etree.ElementTree as ET
from tqdm import tqdm

# ── tunables ─────────────────────────────────────────────────────────────────

MAX_RPS          = 10                        # hard ceiling imposed by SEC
MAX_KBYTES       = 50_000                    # skip files larger than this
DOWNLOAD_WORKERS = min(MAX_RPS * 3, 32)      # 3× headroom for latency variance
PARSE_WORKERS    = max(1, (os.cpu_count() or 2) - 1)   # leave 1 core for OS
PARSE_QUEUE_MAX  = PARSE_WORKERS * 8         # back-pressure ceiling

HEADERS = {"User-Agent": "Leo (leo.caers@gmail.com)"}
EDGAR_ARCHIVES  = "https://www.sec.gov/Archives/"
EDGAR_INDEX_URL = "https://www.sec.gov/Archives/edgar/full-index/"


# ── SEC helpers ───────────────────────────────────────────────────────────────

def fetch_form_index(year: int, quarter: int) -> str:
    if not (1993 <= year <= 2025):
        raise ValueError("Year must be between 1993 and 2025")
    if not (1 <= quarter <= 4):
        raise ValueError("Quarter must be between 1 and 4")
    url = f"{EDGAR_INDEX_URL}/{year}/QTR{quarter}/form.idx"
    r = requests.get(url, headers=HEADERS)
    r.raise_for_status()
    return r.text


def parse_form_idx(text: str) -> pd.DataFrame:
    lines = text.splitlines()
    start = next(
        (i + 1 for i, line in enumerate(lines) if re.match(r"-{5,}", line)),
        0,
    )
    rows = [
        parts
        for line in lines[start:]
        if line.strip() and len(parts := re.split(r"\s{2,}", line.strip())) == 5
    ]
    df = pd.DataFrame(rows, columns=["form_type", "company_name", "cik", "date_filed", "file_name"])
    df["cik"] = df["cik"].astype(str)
    return df


def prune_forms_not_of_type(df: pd.DataFrame, form_type: str) -> pd.DataFrame:
    return df[df["form_type"] == form_type].copy()


# ── token bucket ──────────────────────────────────────────────────────────────

class TokenBucket:
    """
    Releases exactly `rate` permits per second via a background daemon.
    Callers block on acquire() until a token is available.

    The refill loop uses absolute ticks (next_tick += interval) rather than
    sleeping for interval each iteration, so it self-corrects for any drift
    introduced by Python's scheduler.
    """

    def __init__(self, rate: float) -> None:
        self._interval = 1.0 / rate          # must be set before the thread starts
        self._sem   = threading.Semaphore(0)
        self._stop  = threading.Event()
        self._thread = threading.Thread(target=self._refill, daemon=True, name="token-bucket")
        self._thread.start()

    def _refill(self) -> None:
        next_tick = time.monotonic() + self._interval
        while not self._stop.is_set():
            sleep_for = next_tick - time.monotonic()
            if sleep_for > 0:
                time.sleep(sleep_for)
            self._sem.release()
            next_tick += self._interval

    def acquire(self) -> None:
        self._sem.acquire()

    def stop(self) -> None:
        self._stop.set()


# ── thread-safe blacklist ─────────────────────────────────────────────────────

class Blacklist:
    def __init__(self, path: Path) -> None:
        self._path = path
        self._lock = threading.Lock()
        if path.exists():
            df = pd.read_csv(path, dtype={"cik": int})
            self._ciks: set[int] = set(df["cik"].tolist())
            self._df = df
        else:
            self._ciks = set()
            self._df   = pd.DataFrame(columns=["cik", "ticker", "reason"])

    def __contains__(self, cik: int) -> bool:
        return cik in self._ciks          # no lock needed: set reads are atomic in CPython

    def add(self, cik: int, ticker: Optional[str], reason: str) -> None:
        with self._lock:
            if cik in self._ciks:
                return
            self._ciks.add(cik)
            self._df = pd.concat(
                [self._df, pd.DataFrame([{"cik": cik, "ticker": ticker, "reason": reason}])],
                ignore_index=True,
            )
            self._df.to_csv(self._path, index=False)


# ── per-CIK write lock (prevents duplicate downloads in a race) ──────────────

class CIKLocks:
    """Lazily creates one lock per CIK; only holds a global lock during creation."""

    def __init__(self) -> None:
        self._global = threading.Lock()
        self._locks: dict[int, threading.Lock] = {}

    def get(self, cik: int) -> threading.Lock:
        try:
            return self._locks[cik]
        except KeyError:
            with self._global:
                if cik not in self._locks:
                    self._locks[cik] = threading.Lock()
                return self._locks[cik]


# ── pure functions (must be importable in worker processes) ──────────────────

def _strip_until_xml_declaration(s: str) -> str:
    idx = s.find("<?xml")
    if idx == -1:
        raise ValueError("No XML declaration found")
    return s[idx:]


def _get_xml_tree(file_path: Path) -> Optional[ET.Element]:
    with open(file_path, "r", encoding="utf-8") as f:
        soup = BeautifulSoup(f, "lxml")
    docs = soup.find_all("xml")
    if len(docs) != 2:
        return None
    xbrl = _strip_until_xml_declaration(docs[-1].decode_contents())
    return ET.fromstring(xbrl)


def _extract_dataframes(tree: ET.Element):
    contexts: list[list] = []
    values:   list[list] = []
    in_context = False
    row: list  = []

    for el in tree.iter():
        if "}" not in el.tag:
            return None, None
        tag = el.tag.split("}")[1]

        if in_context:
            match tag:
                case "startdate":
                    row.append(el.text)
                case "enddate":
                    row += [el.text, datetime.strptime(el.text, "%Y-%m-%d").year]
                    contexts.append(row)
                    row = []
                    in_context = False
                case "instant":
                    row += ["None", el.text, datetime.strptime(el.text, "%Y-%m-%d").year]
                    contexts.append(row)
                    row = []
                    in_context = False
                case _:
                    continue
        else:
            match tag:
                case "context":
                    row = [tag, el.get("id")]
                    in_context = True
                case "unit" | "measure" | "unitdenominator" | "unitnumerator" \
                   | "xbrl" | "schemaref" | "divide":
                    continue
                case _:
                    val = el.text
                    if val and len(str(val)) > 20:
                        continue
                    values.append([tag, el.get("contextref"), val])

    df_ctx = pd.DataFrame(contexts, columns=["type", "context", "startdate", "enddate", "year"])
    df_val = pd.DataFrame(values,   columns=["type", "context", "value"])
    return df_ctx, df_val


def parse_and_save(task: dict) -> dict:
    """Entry point for ProcessPoolExecutor workers."""
    html_path     = Path(task["local_file_path"])
    contexts_path = Path(task["contexts_path"])
    values_path   = Path(task["values_path"])
    cik    = task["cik"]
    ticker = task["ticker"]

    try:
        if html_path.stat().st_size / 1024 > MAX_KBYTES:
            return {"status": "skipped_size", "cik": cik, "ticker": ticker}

        tree = _get_xml_tree(html_path)
        if tree is None:
            return {"status": "blacklist", "cik": cik, "ticker": ticker,
                    "reason": "Inconsistent format"}

        df_ctx, df_val = _extract_dataframes(tree)
        if df_ctx is None or df_val is None:
            return {"status": "blacklist", "cik": cik, "ticker": ticker,
                    "reason": "Inconsistent format"}

        df_ctx.to_csv(contexts_path, index=False)
        df_val.to_csv(values_path,   index=False)
        return {"status": "ok", "cik": cik, "ticker": ticker}

    except Exception as exc:
        return {"status": "blacklist", "cik": cik, "ticker": ticker, "reason": str(exc)}


# ── helpers ───────────────────────────────────────────────────────────────────

def lookup_ticker(cik: int, lookup_df: pd.DataFrame) -> Optional[str]:
    match = lookup_df.loc[lookup_df["cik_str"] == cik, "ticker"]
    return str(match.iloc[0]) if not match.empty else None


def build_file_paths(
    cik: int, ticker: Optional[str], form_type: str, year: int, quarter: int
) -> tuple[Path, Path, Path]:
    base = Path(f"data/company_data/{ticker}/") if ticker else Path(f"data/no_ticker_data/{cik}/")
    base.mkdir(parents=True, exist_ok=True)
    return (
        base / f"{form_type}_{year}_Q{quarter}.html",
        base / f"Contexts_{form_type}_{year}_Q{quarter}.csv",
        base / f"Values_{form_type}_{year}_Q{quarter}.csv",
    )


# ── download worker (one per thread) ─────────────────────────────────────────

def download_row(
    row:          pd.Series,
    lookup_df:    pd.DataFrame,
    blacklist:    Blacklist,
    cik_locks:    CIKLocks,
    bucket:       TokenBucket,
    parse_queue:  queue.Queue,
    tqdm_lock:    threading.Lock,
    form_type:    str,
    year:         int,
    quarter:      int,
    bar:          tqdm,
    pending:      "threading.Semaphore",   # counts in-flight + queued parse jobs
) -> None:
    cik    = int(row["cik"])
    ticker = lookup_ticker(cik, lookup_df)

    def tick(desc: str) -> None:
        with tqdm_lock:
            bar.set_description(desc, refresh=True)
            bar.update(1)

    if cik in blacklist:
        tick(f"skip {ticker or cik}")
        return

    html_path, ctx_path, val_path = build_file_paths(cik, ticker, form_type, year, quarter)

    # ── download ──────────────────────────────────────────────────────────
    if not html_path.exists():
        with cik_locks.get(cik):               # one thread writes per CIK
            if not html_path.exists():         # re-check after acquiring
                bucket.acquire()
                url = f"{EDGAR_ARCHIVES}{row['file_name']}"
                try:
                    resp = requests.get(url, headers=HEADERS, timeout=30)
                    resp.raise_for_status()
                    html_path.write_text(resp.text, encoding="utf-8")
                except Exception as exc:
                    blacklist.add(cik, ticker, f"download: {exc}")
                    tick(f"✗ {ticker or cik}")
                    return

    # ── enqueue for parsing ───────────────────────────────────────────────
    if not (ctx_path.exists() and val_path.exists()):
        task = {
            "local_file_path": str(html_path),
            "contexts_path":   str(ctx_path),
            "values_path":     str(val_path),
            "cik":             cik,
            "ticker":          ticker,
        }
        # put() with a timeout loop keeps the thread interruptible (e.g. KeyboardInterrupt)
        while True:
            try:
                parse_queue.put(task, timeout=1.0)
                break
            except queue.Full:
                continue

    tick(f"↓ {ticker or cik}")


# ── main ──────────────────────────────────────────────────────────────────────

def main() -> None:
    YEAR      = 2025
    QUARTER   = 1
    FORM_TYPE = "10-K"

    CIK_lookup_df = pd.read_json("data/company_tickers.json").T

    blacklist = Blacklist(Path("data/blacklist.csv"))
    cik_locks = CIKLocks()
    bucket    = TokenBucket(rate=MAX_RPS)
    tqdm_lock = threading.Lock()

    # ── form index ────────────────────────────────────────────────────────
    index_path = Path(f"data/form_indexes/form_index_{FORM_TYPE}_{YEAR}_Q{QUARTER}.csv")
    index_path.parent.mkdir(parents=True, exist_ok=True)
    if index_path.exists():
        df = pd.read_csv(index_path)
    else:
        df = prune_forms_not_of_type(parse_form_idx(fetch_form_index(YEAR, QUARTER)), FORM_TYPE)
        df.to_csv(index_path, index=False)

    parse_queue: "queue.Queue[dict]" = queue.Queue(maxsize=PARSE_QUEUE_MAX)
    bar = tqdm(total=len(df), desc=f"Scraping {FORM_TYPE}s", dynamic_ncols=True)

    mp_ctx = multiprocessing.get_context("spawn")
    active_futures: deque = deque()
    completed_count = 0           # tracks finished download futures without O(n) scan
    total = len(df)

    with (
        ProcessPoolExecutor(max_workers=PARSE_WORKERS, mp_context=mp_ctx) as parse_pool,
        ThreadPoolExecutor(max_workers=DOWNLOAD_WORKERS) as dl_pool,
    ):
        # Submit downloads lazily via a generator — avoids building a list of
        # thousands of futures up front while still letting the executor schedule freely.
        dl_futures = deque(
            dl_pool.submit(
                download_row,
                row, CIK_lookup_df, blacklist, cik_locks, bucket,
                parse_queue, tqdm_lock, FORM_TYPE, YEAR, QUARTER, bar,
                threading.Semaphore(0),   # placeholder; unused in current design
            )
            for _, row in df.iterrows()
        )

        while True:
            # ── reap finished download futures (O(1) amortised) ──────────
            while dl_futures and dl_futures[0].done():
                dl_futures.popleft()
                completed_count += 1

            # ── drain parse queue into process pool ───────────────────────
            try:
                while True:
                    task = parse_queue.get_nowait()
                    active_futures.append(parse_pool.submit(parse_and_save, task))
            except queue.Empty:
                pass

            # ── collect finished parse results ────────────────────────────
            while active_futures and active_futures[0].done():
                result = active_futures.popleft().result()
                if result["status"] == "blacklist":
                    blacklist.add(result["cik"], result["ticker"], result["reason"])

            # ── exit condition ────────────────────────────────────────────
            if completed_count == total and parse_queue.empty() and not active_futures:
                break

            time.sleep(0.05)

    bucket.stop()
    bar.close()
    print(f"\nDone — {PARSE_WORKERS} parse workers, {DOWNLOAD_WORKERS} download threads.")


if __name__ == "__main__":
    main()